<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="6dp" android:background="@drawable/panel">
  <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:id="@+id/heading" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="17sp" android:textStyle="bold" android:textColor="#173B32" android:text="Today"/>
  <TextView android:id="@+id/openNote" android:gravity="center" android:layout_width="wrap_content" android:paddingStart="7dp" android:paddingEnd="7dp" android:textSize="12sp" android:layout_height="32dp" android:background="@drawable/note_button" android:text="Open Note" android:textStyle="bold" android:textColor="#FFFFFF"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/tracker" android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="25dp">
    <TextView android:id="@+id/trackRate" android:singleLine="true" android:textColor="#23493C" android:textStyle="bold" android:textSize="12sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/trackDots" android:singleLine="true" android:textSize="14sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>

  <TextView android:id="@+id/taskHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="12sp" android:paddingTop="3dp" android:textColor="#405348"/>
  <GridView android:id="@+id/tasks" android:layout_width="match_parent" android:layout_height="76dp" android:numColumns="2" android:stretchMode="columnWidth" android:horizontalSpacing="4dp" android:verticalSpacing="1dp" android:scrollbars="vertical" android:contentDescription="Responsibilities"/>
</LinearLayout>
