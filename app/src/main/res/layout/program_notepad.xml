<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="7dp"
    android:paddingEnd="7dp"
    android:clipToPadding="true"
    android:background="?windowBackgroundColor">

    <!-- Shared Classic shell: compact menu and accessible actions on separate rows. -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="24dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="5dp" android:background="#D3CEC7">
        <TextView android:layout_width="wrap_content" android:layout_height="match_parent"
            android:gravity="center_vertical" android:text="File" style="@style/MenuBarItemDisabled"/>
        <TextView android:layout_width="wrap_content" android:layout_height="match_parent"
            android:gravity="center_vertical" android:text="Edit" style="@style/MenuBarItemDisabled"/>
        <TextView android:layout_width="wrap_content" android:layout_height="match_parent"
            android:gravity="center_vertical" android:text="Tools" style="@style/MenuBarItemDisabled"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="30dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="3dp" android:paddingEnd="3dp" android:background="#D3CEC7">
        <TextView android:id="@+id/notepad_add_image" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="match_parent"
            android:gravity="center" android:text="Add Image" android:textColor="#000000"
            android:textSize="10sp" android:clickable="true"/>
        <TextView android:id="@+id/notepad_archive_button" android:layout_width="0dp"
            android:layout_weight="1.3" android:layout_height="match_parent"
            android:gravity="center" android:text="Archived Notes" android:textColor="#000000"
            android:textSize="10sp" android:clickable="true"/>
        <TextView android:id="@+id/notepad_rename_action" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="match_parent"
            android:gravity="center" android:text="Rename" android:textColor="#000000"
            android:textSize="10sp" android:clickable="true"/>
        <TextView android:id="@+id/expand_button" android:layout_width="42dp"
            android:layout_height="match_parent" android:gravity="center"
            android:text="&lt;" android:textColor="#000000" android:textSize="14sp"
            android:background="@drawable/win98_start_menu_border"
            android:clickable="true" android:focusable="true"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="27dp"
        android:orientation="horizontal" android:background="#D3CEC7"
        android:paddingStart="3dp" android:paddingEnd="3dp"
        android:paddingTop="1dp">
        <TextView android:id="@+id/notepad_day_tab" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="match_parent"
            android:gravity="center" android:text="Day-to-Day" android:textSize="10sp"
            android:fontFamily="?primaryFontFamily" android:textColor="#000000" android:clickable="true"/>
        <TextView android:id="@+id/notepad_long_tab" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="match_parent"
            android:gravity="center" android:text="Long-Term" android:textSize="10sp"
            android:fontFamily="?primaryFontFamily" android:textColor="#000000" android:clickable="true"/>
        <TextView android:id="@+id/notepad_reminder_tab" android:layout_width="0dp"
            android:layout_weight="1.4" android:layout_height="match_parent"
            android:gravity="center" android:text="Reminder Notes" android:textSize="9sp"
            android:fontFamily="?primaryFontFamily" android:textColor="#000000" android:clickable="true"/>
    </LinearLayout>

    <!-- One built-in reminder editor, visible only for Reminder Notes. -->
    <LinearLayout android:id="@+id/notepad_reminder_panel"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="4dp"
        android:background="#D3CEC7" android:visibility="gone">
        <EditText android:id="@+id/notepad_reminder_subject"
            android:layout_width="match_parent" android:layout_height="35dp"
            android:singleLine="true" android:hint="Notification subject"
            android:textColor="#000000" android:textSize="12sp"
            android:paddingStart="6dp" android:background="@android:color/white"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="34dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/notepad_reminder_when"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="match_parent" android:gravity="center_vertical"
                android:text="No date or time set" android:textColor="#000000" android:textSize="11sp"/>
            <TextView android:id="@+id/notepad_reminder_set"
                android:layout_width="112dp" android:layout_height="32dp"
                android:gravity="center" android:text="Set Date / Time"
                android:textColor="#000000" android:textSize="11sp"
                android:background="@drawable/win98_start_menu_border"
                android:clickable="true" android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:background="#777777"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <LinearLayout
            android:id="@+id/notes_list_container"
            android:layout_width="99dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#D3CEC7"
            android:paddingEnd="2dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/notes_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@android:color/transparent" />


            <TextView
                android:id="@+id/add_note_button"
                style="?winButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:layout_marginBottom="3dp"
                android:text="Add"
                android:textColor="@color/black"
                android:textSize="10sp"
                android:fontFamily="?primaryFontFamily"
                android:gravity="center"
                android:backgroundTint="@null"
                android:clickable="true"
                android:focusable="true"/>


        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="2dp"
            android:background="@android:color/white">

            <!-- Image Gallery -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/image_gallery"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="horizontal"
                android:visibility="gone"
                android:padding="4dp"
                android:background="@color/white" />

            <!-- Text Editor -->
            <EditText
                android:id="@+id/notes"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:gravity="top|start"
                android:background="@android:color/white"
                android:textColor="@android:color/black"
                android:fontFamily="?attr/primaryFontFamily"
                android:textSize="13sp"
                android:text="Test test"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="20dp"
                android:paddingBottom="6dp"
                android:scrollbars="vertical"
                android:scrollbarStyle="outsideOverlay"
                android:scrollbarAlwaysDrawVerticalTrack="true"
                android:scrollbarSize="16dp"
                android:scrollbarFadeDuration="0"
                android:scrollbarDefaultDelayBeforeFade="0"
                android:fadeScrollbars="false"
                android:scrollbarTrackVertical="?scrollbarTrackDrawable"
                android:scrollbarThumbVertical="?scrollbarThumbDrawable"
                android:inputType="textMultiLine|textNoSuggestions"
                android:lineSpacingMultiplier="1.0"
                android:lineSpacingExtra="0dp">
            </EditText>

        </LinearLayout>


    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true"
        android:background="?windowBackgroundColor"
        android:gravity="start">
        <ImageView
            android:layout_width="15dp"
            android:layout_height="18dp"
            android:background="@drawable/window_bottom_left"/>
        <ImageView
            android:layout_width="0dp"
            android:layout_height="18dp"
            android:layout_weight="1"
            android:background="@drawable/window_bottom_middle"/>
        <ImageView
            android:id="@+id/resize_drag_view"
            android:layout_width="30dp"
            android:layout_height="18dp"
            android:background="@drawable/window_bottom_right"/>

    </LinearLayout>

</LinearLayout>